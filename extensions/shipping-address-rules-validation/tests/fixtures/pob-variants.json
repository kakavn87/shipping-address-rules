      "cart": {
        "deliveryGroups": [{
          "deliveryAddress": {
            "address1": "P.O.B. 77",
            "address2": null,
            "city": "Dallas",
            "provinceCode": "TX",
            "zip": "75001",
            "countryCode": "US"
          }
        }],
        "validation": { "metafield": null }
      }
    },
    "output": {
      "operations": [{
        "validationAdd": {
          "errors": [{
